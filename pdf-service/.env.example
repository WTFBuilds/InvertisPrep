# Server
PORT=5002
NODE_ENV=development

# Set TRUST_PROXY=1 when deployed behind a reverse proxy (Vercel, nginx, etc.)
TRUST_PROXY=0

# Database (same cluster as main server)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/invertisprep?retryWrites=true&w=majority

# JWT Secret (MUST match main server — generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-random-32-byte-hex

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis (Upstash) - for BullMQ job queue
REDIS_URL=redis://default:password@host:port

# Internal Service Communication (shared with main server — generate with: openssl rand -hex 32)
INTERNAL_SERVICE_TOKEN=replace-with-random-token

# Main Server URL (for user fallback validation)
MAIN_SERVER_URL=http://localhost:5000

# PDF Cache Configuration
PDF_CACHE_MAX_MB=80
PDF_LRU_MAX_ENTRIES=40

# Rate Limiting (optional - defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
PDF_RATE_LIMIT_WINDOW_MS=60000
PDF_RATE_LIMIT_MAX=120
READ_RATE_LIMIT_WINDOW_MS=900000
READ_RATE_LIMIT_MAX=2000
WRITE_RATE_LIMIT_WINDOW_MS=900000
WRITE_RATE_LIMIT_MAX=200
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=30

# CORS Origins (comma-separated)
CORS_ORIGINS=https://your-client.vercel.app,https://your-other-domain.com

# Max PDF Size (MB)
MAX_PDF_SIZE_MB=10