# ── Client environment ──────────────────────────────────────────────────────
# Copy to .env for local development:  cp .env.example .env
#
# 🔒 NO NEXT_PUBLIC_* URL VARIABLES.
# The browser calls same-origin paths (/backend/*, /pdfapi/*) and Next.js
# rewrites (next.config.ts) proxy them to the real backends using the
# SERVER-ONLY vars below. Backend URLs never appear in the browser bundle,
# and the refresh cookie is first-party (no cross-site cookie issues).
#
# Set these in the Vercel dashboard (Settings → Environment Variables)
# BEFORE deploying — rewrites are evaluated at build time.

# Main API server (Render)
API_URL=http://localhost:5000/api

# PDF microservice (Render)
PDF_API_URL=http://localhost:5002/api

# ── NextAuth (Google OAuth handshake only — server-side) ───────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-secret

# Google OAuth credentials (same client ID/secret as the main server)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── SEO ─────────────────────────────────────────────────────────────────────
# Google Search Console verification token. Get it from GSC (Settings →
# Ownership verification → HTML tag → copy the content="..." value) and set it
# in Vercel. When present, the root layout emits
# <meta name="google-site-verification" content="...">.
GOOGLE_SITE_VERIFICATION=

