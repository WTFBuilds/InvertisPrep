# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Use a local MongoDB instance for development if Atlas is not available.
MONGODB_URI=mongodb://127.0.0.1:27017/invertisprep
# Or use Atlas with your cluster connection string:
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/invertisprep?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=invertisprep-secret-key-change-in-production-2024
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Configuration
# Comma-separated list of allowed origins. CLIENT_URL is kept for backwards-compat
# but CORS_ORIGINS takes precedence if set.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
CLIENT_URL=http://localhost:3000

# Security / Rate Limiting
# Set TRUST_PROXY=1 when deploying behind a reverse proxy (Vercel, nginx, Render, etc.)
TRUST_PROXY=0

# Body parser limit for JSON payloads (resume drafts carry small base64 photos)
BODY_LIMIT=3mb

# General API rate limit (all /api routes) — requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Auth rate limit (login / Google OAuth) — protects against brute force
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Upload rate limit (PDF / image uploads) — requests per window
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=30

# PDF view/download rate limit (watermark pipeline) — requests per window
PDF_RATE_LIMIT_WINDOW_MS=60000
PDF_RATE_LIMIT_MAX=60

# Max upload size (MB)
MAX_PDF_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5

# Max PYQ papers a non-admin can upload per day
DAILY_UPLOAD_LIMIT=10
